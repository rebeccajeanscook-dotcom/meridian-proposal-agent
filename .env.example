# Copy this file to .env and paste your key after the = sign. Never commit .env.
ANTHROPIC_API_KEY=

# Only needed if your key is not tied to one workspace (error: "anthropic-workspace-id is required").
# Find it in the Console: Settings -> Workspaces -> ID column (looks like wrkspc_01...).
ANTHROPIC_WORKSPACE_ID=

# Optional settings
# CLAUDE_MODEL=claude-haiku-5-5      # or claude-sonnet-5-5 / claude-opus-5-5
# WHISPER_MODEL=small          # tiny | base | small | medium (bigger = more accurate, slower)
# CHALLENGE_DIR=../meridian-ai-challenge 2
